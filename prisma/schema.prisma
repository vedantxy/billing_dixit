generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Cadence {
  monthly
  yearly
  once
}

enum SubscriptionStatus {
  active
  paused
  cancelled
  past_due
}

enum InvoiceStage {
  draft
  issued
}

enum PaymentStatus {
  successful
  pending
  failed
}

enum PaymentMethod {
  upi
  bank_transfer
  card
  cash
  other
}

model Customer {
  id              String           @id
  name            String
  email           String           @unique
  phone           String
  address         String
  archived        Boolean          @default(false)
  createdOn       DateTime         @db.Date
  workshopRecords WorkshopRecord[]
  subscriptions   Subscription[]
  invoices        Invoice[]
}

model Product {
  id          String  @id
  name        String
  description String
  enabled     Boolean @default(true)
  plans       Plan[]
}

model Plan {
  id            String         @id
  productId     String
  name          String
  cadence       Cadence
  price         Int
  enabled       Boolean        @default(true)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  lines         InvoiceLine[]

  @@index([productId])
}

model Subscription {
  id         String              @id
  customerId String
  planId     String
  planLabel  String
  price      Int
  cadence    Cadence
  status     SubscriptionStatus
  startDate  DateTime            @db.Date
  nextDate   DateTime            @db.Date
  anchorDay  Int
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan       Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  events     SubscriptionEvent[]
  invoices   Invoice[]

  @@index([customerId])
  @@index([status, nextDate])
}

model SubscriptionEvent {
  id             String       @id
  subscriptionId String
  at             DateTime
  message        String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, at])
}

model Invoice {
  id              String           @id
  sequence        Int              @unique
  customerId      String
  subscriptionId  String?
  billTo          String
  billEmail       String
  billAddress     String
  stage           InvoiceStage
  issuedOn        DateTime         @db.Date
  dueOn           DateTime         @db.Date
  discountBps     Int
  taxBps          Int
  notes           String
  seller          Json?
  workshopAnnex   Json?
  workshopRecords WorkshopRecord[]
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscription    Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  lines           InvoiceLine[]
  payments        Payment[]

  @@index([customerId, issuedOn])
  @@index([stage, dueOn])
}

model InvoiceLine {
  id          String  @id
  invoiceId   String
  planId      String?
  position    Int
  description String
  quantity    Int
  unitPrice   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  plan        Plan?   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, position])
}

model Payment {
  id        String        @id
  invoiceId String
  amount    Int
  paidOn    DateTime      @db.Date
  method    PaymentMethod
  status    PaymentStatus
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([status, paidOn])
}

model Mutation {
  key       String   @id
  signature String
  result    Json
  createdAt DateTime @default(now())
}

model Staff {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  role         String
  passwordHash String
  disabled     Boolean        @default(false)
  sessions     StaffSession[]
}

model StaffSession {
  digest    String   @id
  staffId   String
  expiresAt DateTime
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model LoginBucket {
  key      String   @id
  attempts Int
  since    DateTime
}

model AuditEvent {
  id       String   @id @default(uuid())
  at       DateTime @default(now())
  actor    String
  action   String
  recordId String

  @@index([at])
}

model WorkshopWorker {
  id      String           @id @default(uuid())
  name    String
  job     String
  machine String
  rate    Int
  active  Boolean          @default(true)
  marks   WorkshopMark[]
  records WorkshopRecord[]
}

model WorkshopMark {
  id            String         @id @default(uuid())
  workerId      String
  day           DateTime       @db.Date
  status        String
  extraHalfDays Int            @default(0)
  machine       String         @default("")
  rate          Int
  worker        WorkshopWorker @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@unique([workerId, day])
  @@index([day])
}

model WorkshopRecord {
  id          String           @id @default(uuid())
  day         DateTime         @db.Date
  kind        String
  category    String
  party       String
  memo        String
  reference   String
  cash        Int              @default(0)
  bank        Int              @default(0)
  amount      Int
  detail      Json
  workerId    String?
  customerId  String?
  invoiceId   String?
  parentId    String?
  worker      WorkshopWorker?  @relation(fields: [workerId], references: [id], onDelete: Restrict)
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  parent      WorkshopRecord?  @relation("Settlements", fields: [parentId], references: [id], onDelete: Restrict)
  settlements WorkshopRecord[] @relation("Settlements")
  createdAt   DateTime         @default(now())
  voidedAt    DateTime?
  voidReason  String?

  @@index([day, kind])
  @@index([workerId, day])
  @@index([customerId])
  @@index([invoiceId])
  @@index([parentId])
}

model BusinessProfile {
  id      String @id
  name    String
  address String
  contact String
  taxId   String
  terms   String
}
