{
  "name": "billfold-billing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "db:setup": "prisma generate && npm run db:migrate",
    "test": "node --test tests/*.test.mjs",
    "staff": "node --env-file-if-exists=.env scripts/staff.mjs",
    "test:integration": "node tests/integration/workshop.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.2.8",
    "@fontsource/instrument-serif": "^5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "6.19.3",
    "lucide-react": "0.552.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "regenerator-runtime": "0.14.1"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
